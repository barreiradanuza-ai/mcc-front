generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MccUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("mcc_users")
}

model CepClaro {
  cep String @id @db.Char(8)

  @@map("ceps_claro")
}

model CepTim {
  cep String @id @db.Char(8)

  @@map("ceps_tim")
}

model CidadePromoClaro {
  cidade String @id

  @@map("cidades_promo_claro")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model nio_cache_meta {
  id         Int       @id
  updated_at DateTime? @db.Timestamptz(6)
  total      Int?
}

model CepNio {
  cep String @id @db.Char(8)

  @@map("ceps_nio")
}

model SuperListaNio {
  id               BigInt   @id @default(autoincrement())
  cep              String   @db.Char(8)
  uf               String   @db.VarChar(2)
  municipio        String?  @db.VarChar(120)
  bairro           String?  @db.VarChar(160)
  logradouro       String?  @db.VarChar(240)
  noFachada        String?  @map("no_fachada") @db.VarChar(40)
  complemento1     String?  @map("complemento1") @db.VarChar(160)
  complemento2     String?  @map("complemento2") @db.VarChar(160)
  complemento3     String?  @map("complemento3") @db.VarChar(160)
  codigoLogradouro String?  @map("codigo_logradouro") @db.VarChar(80)
  codigoCdo        String?  @map("codigo_cdo") @db.VarChar(80)
  classificacao    String?  @db.VarChar(80)
  celula           String?  @db.VarChar(80)
  estacao          String?  @db.VarChar(80)
  viabilidadeAtual String?  @map("viabilidade_atual") @db.VarChar(100)
  regiao           String?  @db.VarChar(40)
  relatorioOrigem  String?  @map("relatorio_origem") @db.VarChar(120)
  atualizadoEm     DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@index([cep])
  @@index([uf, municipio])
  @@index([viabilidadeAtual])
  @@map("super_lista_nio")
}

model CpfCobertura {
  cpf          String   @id @db.VarChar(11)
  cep          String?  @db.Char(8)
  contato      String?  @db.VarChar(13)
  cobertura    String
  motivoRecusa String?  @map("motivo_recusa")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("cpfs_cobertura")
}

model AppConfig {
  key       String   @id @db.VarChar(50)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("app_config")
}
