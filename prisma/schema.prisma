generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MccUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("mcc_users")
}

model CepClaro {
  cep String @id @db.Char(8)

  @@map("ceps_claro")
}

model CepTim {
  cep String @id @db.Char(8)

  @@map("ceps_tim")
}

model CidadePromoClaro {
  cidade String @id

  @@map("cidades_promo_claro")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model nio_cache_meta {
  id         Int       @id
  updated_at DateTime? @db.Timestamptz(6)
  total      Int?
}

model CepNio {
  cep String @id @db.Char(8)

  @@map("ceps_nio")
}

model SuperListaNio {
  id               BigInt   @id @default(autoincrement())
  cep              String   @db.Char(8)
  uf               String   @db.VarChar(2)
  municipio        String?  @db.VarChar(120)
  bairro           String?  @db.VarChar(160)
  logradouro       String?  @db.VarChar(240)
  noFachada        String?  @map("no_fachada") @db.VarChar(40)
  complemento1     String?  @map("complemento1") @db.VarChar(160)
  complemento2     String?  @map("complemento2") @db.VarChar(160)
  complemento3     String?  @map("complemento3") @db.VarChar(160)
  codigoLogradouro String?  @map("codigo_logradouro") @db.VarChar(80)
  codigoCdo        String?  @map("codigo_cdo") @db.VarChar(80)
  classificacao    String?  @db.VarChar(80)
  celula           String?  @db.VarChar(80)
  estacao          String?  @db.VarChar(80)
  viabilidadeAtual String?  @map("viabilidade_atual") @db.VarChar(100)
  regiao           String?  @db.VarChar(40)
  relatorioOrigem  String?  @map("relatorio_origem") @db.VarChar(120)
  atualizadoEm     DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@index([cep])
  @@index([uf, municipio])
  @@index([viabilidadeAtual])
  @@map("super_lista_nio")
}

model CpfCobertura {
  cpf          String   @id @db.VarChar(11)
  cep          String?  @db.Char(8)
  contato      String?  @db.VarChar(13)
  cobertura    String
  motivoRecusa String?  @map("motivo_recusa")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("cpfs_cobertura")
}

model AppConfig {
  key       String   @id @db.VarChar(50)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("app_config")
}

model CpfGerado {
  cpf       String   @id @db.VarChar(11)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("cpfs_gerados")
}

/// Preset de disparo: para onde os leads vão no DataCrazy e como as colunas da planilha são mapeadas.
model DisparoPreset {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(120)
  descricao   String?
  listaId     String?  @map("lista_id") @db.VarChar(80)
  listaNome   String?  @map("lista_nome") @db.VarChar(160)
  tagId       String?  @map("tag_id") @db.VarChar(80)
  tagNome     String?  @map("tag_nome") @db.VarChar(160)
  /// "fixa" usa tagId; "por_envio" cria uma tag nova a cada envio a partir de tagPadrao
  tagModo     String   @default("por_envio") @map("tag_modo") @db.VarChar(20)
  /// padrão do nome da tag por envio, ex.: "api_{arquivo}" ({arquivo}, {data}, {hora})
  tagPadrao   String?  @map("tag_padrao") @db.VarChar(160)
  pipelineId  String?  @map("pipeline_id") @db.VarChar(80)
  pipelineNome String? @map("pipeline_nome") @db.VarChar(160)
  stageId     String?  @map("stage_id") @db.VarChar(80)
  stageNome   String?  @map("stage_nome") @db.VarChar(160)
  origem      String?  @db.VarChar(120)
  filtroColuna String? @map("filtro_coluna") @db.VarChar(120)
  filtroValor  String? @map("filtro_valor") @db.VarChar(120)
  /// { campos: { name: "NOME", phone: "CONTATO", ... }, observacoes: ["Cobertura", ...] }
  mapeamento  Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  envios      DisparoEnvio[]

  @@map("disparo_presets")
}

/// Histórico de envios de planilhas ao DataCrazy.
model DisparoEnvio {
  id          Int      @id @default(autoincrement())
  presetId    Int?     @map("preset_id")
  preset      DisparoPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  presetNome  String   @map("preset_nome") @db.VarChar(120)
  arquivo     String   @db.VarChar(255)
  tagNome     String?  @map("tag_nome") @db.VarChar(160)
  status      String   @db.VarChar(20)
  total       Int      @default(0)
  filtrados   Int      @default(0)
  criados     Int      @default(0)
  atualizados Int      @default(0)
  falhas      Int      @default(0)
  mensagem    String?
  /// [{ linha, nome, telefone, erro }]
  erros       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz()

  @@map("disparo_envios")
}

/// Leads já enviados ao DataCrazy (evita reenviar o mesmo lead em importações futuras).
model DisparoLeadEnviado {
  id          Int      @id @default(autoincrement())
  telefone    String   @db.VarChar(16)
  cpf         String?  @db.VarChar(11)
  dcLeadId    String?  @map("dc_lead_id") @db.VarChar(80)
  envioId     Int?     @map("envio_id")
  presetNome  String?  @map("preset_nome") @db.VarChar(120)
  tagNome     String?  @map("tag_nome") @db.VarChar(160)
  enviadoEm   DateTime @default(now()) @map("enviado_em") @db.Timestamptz()

  @@unique([telefone])
  @@index([cpf])
  @@map("disparo_leads_enviados")
}

/// Planilhas guardadas no portal para segmentar em várias bases/tags.
model DisparoBase {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(200)
  arquivo   String   @db.VarChar(255)
  headers   Json
  rows      Json
  total     Int      @default(0)
  origem    String?  @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("disparo_bases")
}
